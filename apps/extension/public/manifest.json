{
  "manifest_version": 3,
  "name": "Bill Split — Walmart orders",
  "version": "0.1.5",
  "description": "Split a Walmart order item by item with your group.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.walmart.com/*",
    "https://bsplit.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.walmart.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Split this Walmart order",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
